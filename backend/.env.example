# Copy to .env for local runs. Cloud Run gets these from deploy/env.cloudrun.yaml
# instead — the same names, different values. That is the whole trick: one image,
# configured by its environment.

# ---- which adapters to use -------------------------------------------------
# local + memory = no Google credentials needed. Good for poking at /docs.
# gcs + firestore = the real thing (needs Application Default Credentials).
STORAGE_BACKEND=local
DB_BACKEND=memory

# ---- Google Cloud (only read when the gcs / firestore adapters are chosen) ----
# GCP_PROJECT=your-project-id
# GCS_BUCKET=croplytix-your-project-id-uploads
# FIRESTORE_DATABASE=(default)

# ---- local adapter -----------------------------------------------------------
LOCAL_STORAGE_DIR=./.data/objects

# ---- HTTP ---------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API. Only matters
# when the page is served from somewhere other than the API (Vite on :3000, or a
# frontend on a different Cloud Run URL). Same-origin behind nginx: irrelevant.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Per-file ceiling. On Cloud Run the whole request must stay under 32 MiB anyway,
# so a lower number here just turns an opaque gateway error into a clear 413.
MAX_UPLOAD_MB=30
