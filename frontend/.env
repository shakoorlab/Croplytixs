# Router base path; the app is served from the site root.
VITE_APP_BASE_NAME = /

# Identity Platform web config, from Identity Platform → Providers → Application setup
# details. Not secrets: they ship in the JS bundle and only identify the project.
VITE_FIREBASE_API_KEY =
VITE_FIREBASE_AUTH_DOMAIN = not-croplytixs.firebaseapp.com
