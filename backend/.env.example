# Copy to .env for local runs. Cloud Run gets these from deploy/env.cloudrun.yaml
# instead — the same names, different values. That is the whole trick: one image,
# configured by its environment.

# ---- which adapters to use -------------------------------------------------
# local + memory = no Google credentials needed. Good for poking at /docs.
# gcs + firestore = the real thing (needs Application Default Credentials).
STORAGE_BACKEND=local
DB_BACKEND=memory

# ---- Google Cloud (only read when the gcs / firestore adapters are chosen) ----
# GCP_PROJECT=your-project-id
# GCS_BUCKET=croplytix-your-project-id-uploads
# FIRESTORE_DATABASE=(default)

# ---- sign-in -------------------------------------------------------------------
# Whose Identity Platform sign-ins to trust (the project the browser signs in to).
# Required: the API won't start without it (or GCP_PROJECT). Verifying tokens
# needs internet access to fetch Google's public keys, but no Google credentials.
AUTH_PROJECT_ID=not-croplytixs

# ---- local adapter -----------------------------------------------------------
LOCAL_STORAGE_DIR=./.data/objects

# ---- HTTP ---------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API. Only matters
# when the page is served from somewhere other than the API (Vite on :3000, or a
# frontend on a different Cloud Run URL). Same-origin behind nginx: irrelevant.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Largest files the API opens an upload session for. The browser sends the bytes
# straight to storage (here: to /api/local-uploads), so these are not Cloud Run's
# limits. The ortho's real ceiling is the memory ingest has for its COGs.
MAX_ORTHO_MB=10240
MAX_SHAPEFILE_MB=100

# ---- ingest (orthophoto → COGs) -----------------------------------------------
# inline = build the COGs in this process after each ortho upload (fine locally).
# Cloud Run uses cloudrun + the croplytix-ingest job instead; see docs/gcp-setup.md.
INGEST_RUNNER=inline
# Read orthos in place from a folder that mirrors the bucket, instead of copying
# them first. On Cloud Run that is the job's bucket mount; locally the local
# store's folder is one too:
# INGEST_SOURCE_DIR=./.data/objects
VIEW_COMPRESSION=WEBP
